# BodhAI Backend Configuration
# Copy this to .env and fill in your values

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=bodhai

SERVER_PORT=3000
# Set to your domain/IP for production
SERVER_HOST=0.0.0.0

# JWT secret for API security (optional, generate a random string)
JWT_SECRET=change_this_to_random_string_32chars

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
